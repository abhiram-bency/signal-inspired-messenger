# =============================================================================
# Signal-Inspired Messenger — Environment Variables Reference
# =============================================================================
# Copy this file to:
#   backend/.env        (for the FastAPI backend)
#   frontend/.env.local (for the Next.js frontend)
# and fill in real values. Never commit .env or .env.local files.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (backend/.env)
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database file path (relative to backend/ directory)
DATABASE_URL=sqlite:///./data/messenger.db

# JWT signing secret — change to a strong random value in production
JWT_SECRET=change-me-to-a-strong-random-secret-in-production

# JWT token expiry in seconds (default 7 days)
JWT_EXPIRE_SECONDS=604800

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# FastAPI environment: development | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Fixed mock OTP for development (all users use this code)
MOCK_OTP=123456

# Backend host and port (used by uvicorn)
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (frontend/.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend REST API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Application name displayed in the UI
NEXT_PUBLIC_APP_NAME=Signal
